  ```rust
  pub struct Packing {
      pub files: Vec<FileGroup>,
      pub conditional_splits: Vec<ConditionalSplit>,
      pub exemptions: Vec<NodeId>,   // oversized single symbols
  }

  /// "break these edges first, then this split becomes legal"
  pub struct ConditionalSplit {
      pub group: Vec<NodeId>,
      pub preconditions: BreakSet,   // from the shatter phase
      pub resulting_files: Vec<FileGroup>,
  }

  pub fn pack(folder: &FolderView, cap: u32, breaks: &[BreakSet]) -> Packing
  // logic:
  //   1. affinity per scc-atom pair = sum of edge weights + naming-token cohesion;
  //      sort pairs descending (ties by index for determinism)
  //   2. kruskal-style agglomeration: merge two groups iff combined production
  //      sloc <= cap AND the folder's file-level quotient stays acyclic
  //   3. leftover group > cap and acyclic:
  //      split at the min-weight topological cut — dp over the topological
  //      order minimizing crossing weight, o(n^2) on group size
  //   4. leftover group > cap and cyclic (scc bigger than the cap):
  //      emit conditional_split(preconditions = mfas(group), resulting split)
  //   5. single symbol > cap: flag oversized-symbol exemption; its file is cap-exempt
  // capacity counts production sloc only (node effective_size; testcase files exempt)
  ```

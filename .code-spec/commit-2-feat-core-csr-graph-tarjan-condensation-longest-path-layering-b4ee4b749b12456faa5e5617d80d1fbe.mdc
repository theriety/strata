  /// compressed sparse row adjacency, struct-of-arrays layout (ad-6)
  pub struct Csr {
      /// row offsets, length v + 1; row i spans targets[offsets[i]..offsets[i+1]]
      offsets: Vec<u32>,
      /// edge targets, sorted within each row for determinism
      targets: Vec<u32>,
      /// per-edge weight = kind weight x binder confidence
      weights: Vec<f32>,
  }

  /// build forward and reverse views in one pass over snapshot edges,
  /// filtered by hardness (the solver's acyclicity phases use hard edges only)
  pub fn build_csr(snapshot: &Snapshot, filter: HardnessFilter) -> GraphViews

  pub struct GraphViews { pub forward: Csr, pub reverse: Csr }
  ```

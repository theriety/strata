  pub struct SccId(pub u32);

  pub struct Condensation {
      /// quotient dag over sccs, deduplicated edges
      pub dag: Csr,
      /// node id -> owning scc
      pub membership: Vec<SccId>,
      /// member lists per scc, in deterministic order
      pub members: Vec<Vec<NodeId>>,
  }

  /// iterative tarjan over hard edges — explicit stack of (node, edge-cursor)
  /// frames instead of recursion, so deep graphs cannot overflow the call stack
  pub fn condense(csr: &Csr) -> Condensation
  // logic:
  //   index / lowlink arrays + an explicit dfs frame stack + the scc stack
  //   on frame exit: lowlink[v] == index[v] -> pop one scc
  //   sccs are emitted in reverse topological order (deterministic)
  //   quotient edges: map member edges through membership, sort + dedup
  ```

### Runtime State
  {{ ref: 37db2572-f788-81de-b20e-db3a427f6eb7 }}
  ```rust
  // ir node and edge types (the in-memory graph)
  pub struct Node {
    // identifiers //
    /// stable id, unique within a snapshot
    pub id: NodeId,
    /// interned symbol name
    pub name: SmolStr,

    // classification //
    /// symbol or type node
    pub kind: NodeKind,
    /// production, test case, or test support
    pub polarity: Polarity,

    // placement //
    /// owning file container in the current layout
    pub container: ContainerId,
    /// export scope as written in the source; compared against the derived
    /// scope (a pipeline output) to surface visibility findings
    pub declared_visibility: ScopeLevel,

    // size //
    /// effective sloc of the symbol body: non-blank, non-comment, excluding
    /// docs and docstrings; capacity rules choose which polarities to count
    /// (file cap counts production symbols, helper-cap counts test support)
    pub effective_size: u32,
  }

  pub enum NodeKind { Symbol, Type }
  pub enum Polarity { Production, TestCase, TestSupport }

  pub struct Edge {
    pub source: NodeId,
    pub target: NodeId,
    /// value import, type reference, inheritance, call, or re-export
    pub kind: EdgeKind,
    /// hard edges constrain acyclicity; soft edges only score
    pub hardness: Hardness,
    /// binder certainty, below 1.0 for dynamic constructs
    pub confidence: f64,
  }

  pub enum EdgeKind { ValueImport, TypeReference, Inheritance, Call, ReExport }
  pub enum Hardness { Hard, Soft }
  ```
  --{ ref: 37db2572-f788-81de-b20e-db3a427f6eb7 }--

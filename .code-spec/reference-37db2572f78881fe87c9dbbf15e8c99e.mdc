{{ ref: 37db2572-f788-81d5-a802-c6ed3eaac9cb, is_toggleable: true }}
### Data Transfer Objects
  {{ ref: 37db2572-f788-8137-ae99-d3ea54c90ff3 }}
  ```typescript
  // the analyze result returned by cli --output and strata_engine::analyze
  interface AnalyzeResult {
    schemaVersion: number;
    snapshotHash: string;                       // blake3 of the ir snapshot
    stats: {
      symbols: number; edges: number; files: number;
      filesByLanguage: Record<string, number>;  // e.g. { ts: 1210, rs: 201, py: 71 }
    };
    current: {
      tree: ContainerNode;                      // today's layout, mapped onto the level hierarchy
      score: number;                            // J of the current tree (anchor term is 0 by definition)
      scoreBreakdown: ScoreBreakdown;
      violations: Violation[];
    };
    modes: {
      anchored?: ModeResult;
      greenfield?: ModeResult;
    };
  }

  interface ModeResult {
    candidates: Candidate[];                    // up to k, best score first
    pairwiseDistance: number[][];               // variation-of-information matrix
    solutionSpaceConverged: boolean;            // true when fewer than k returned
  }

  interface Candidate {
    index: number;                              // 1-based
    score: number;                              // total objective, lower is better
    scoreBreakdown: ScoreBreakdown;
    tree: ContainerNode;                        // proposed laminar structure
    conditionalSplits: ConditionalSplit[];      // over-cap sccs with break preconditions
    deltaNarration: Move[];                     // explained moves vs current layout
  }

  interface ScoreBreakdown {
    cut: number; imbalance: number; naming: number; path: number; anchor: number;
  }

  interface ContainerNode {
    name: string;
    level: 'file' | 'folder' | 'domain' | 'package' | 'packageGroup';
    children?: ContainerNode[];                 // absent on files
    symbols?: SymbolPlacement[];                // present on files only
    productionSloc?: number;                    // present on files only
  }

  interface SymbolPlacement {
    name: string;
    // 'public' = declared external api surface of a published package; never narrowed
    visibility: 'file' | 'folder' | 'domain' | 'package' | 'packageGroup' | 'public';
  }

  interface Move {
    kind: 'move' | 'split' | 'merge';
    symbols: string[];                          // affected symbols
    from: string[];                             // source container path(s)
    to: string[];                               // destination container path(s)
    reason: string;                              // e.g. "over cap; min-weight topological cut"
    followsSubject?: string;                    // set on projected spec-file moves
  }

  interface Violation {
    kind: 'cycle' | 'polarity' | 'capacity' | 'visibility';
    severity: 'violation' | 'borderline';
    location: string[];                         // container path(s) involved
    detail: string;
    breakSuggestions?: EdgeBreak[];             // present for cycles
  }

  interface ConditionalSplit {
    scc: string[];                              // member symbols
    preconditions: EdgeBreak[];                 // edges to break first
    resultingFiles: number;                     // split becomes legal after breaking
  }

  interface EdgeBreak {
    source: string; target: string;
    weight: number;
    exact: boolean;                             // ilp-proven vs heuristic
  }
  ```
  --{ ref: 37db2572-f788-8137-ae99-d3ea54c90ff3 }--

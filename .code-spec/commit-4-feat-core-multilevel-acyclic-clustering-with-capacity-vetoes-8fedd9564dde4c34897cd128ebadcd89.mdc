  pub struct CoarseGraph { pub graph: Csr, pub fine_to_coarse: Vec<u32> }

  /// heavy-edge matching chain until the graph is small enough to seed
  pub fn coarsen_chain(dag: &Csr, layers: &[u32]) -> Vec<CoarseGraph>
  // matching rule: a pair (u, v) may merge only if contracting it cannot
  // create a quotient cycle — reject when an alternative directed path
  // u ~> v of length >= 2 exists (checked against the layering: merging
  // is safe when layer(v) - layer(u) <= 1 and no two-hop path connects them)

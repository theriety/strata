  /// fm-style refinement, applied at every uncoarsening level
  pub fn refine(g: &CoarseGraph, parts: &mut Partition, gain: &GainFn)
  // per pass:
  //   for v in descending gain order:
  //     veto 1 — acyclicity: maintain a topological order of the quotient;
  //       moving v from cluster a to b is legal iff it introduces no
  //       order-violating quotient edge (kahn-style local repair, incremental —
  //       never a full recomputation per move)
  //     veto 2 — capacity: cluster b must stay within its level cap
  //     apply iff gain > 0, where gain = cut-weight delta
  //       + alpha * naming-token cohesion + beta * path cohesion (mode-dependent)
  //   stop when a full pass applies no move
  // determinism: ties in gain order broken by node index
  ```

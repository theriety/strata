  ```rust
  /// a set of edges whose removal makes the scc acyclic
  pub struct BreakSet { pub edges: Vec<EdgeRef>, pub exact: bool }

  pub struct SolverLimits {
      /// sccs at or under this size go to the ilp (default 300)
      pub ilp_threshold: usize,
      /// wall-clock budget per scc; overruns degrade to the heuristic
      pub timeout: Duration,
  }

  /// rayon-parallel over sccs; results reduced in scc-index order (deterministic)
  pub fn shatter_all(sccs: &[SccView], w: &EdgeWeights, limits: &SolverLimits) -> Vec<BreakSet>

  // ilp path — lazy cycle constraints (avoids enumerating exponentially many cycles):
  //   constraints = {}
  //   loop:
  //     x = highs.solve(minimize sum w(e) * cut(e), cut(e) binary, constraints)
  //     c = find_cycle(scc minus { e : cut(e) = 1 })      // plain dfs
  //     if none: return BreakSet { edges, exact: true }
  //     constraints += sum over e in c of cut(e) >= 1
  //   on timeout: fall through to els, exact: false

  // els path (eades-lin-smyth, o(v + e)):
  //   repeatedly strip sinks (append right) and sources (prepend left);
  //   otherwise move the vertex maximizing out-degree minus in-degree
  //   cut = backward edges in the final ordering
  //   improve: single-vertex repositioning while total cut weight drops
  ```

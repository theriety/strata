  ```rust
  /// resolve the module graph and emit nodes + edges
  pub fn bind(modules: Vec<ParsedModule>, root: &Path) -> Result<IrFragment, AdapterError>
  // module resolution order: relative path -> tsconfig "paths" alias -> package entry
  // edge emission:
  //   import { x } from ...        -> value-import (hard)
  //   import type { t } from ...   -> type-reference (soft — erased at runtime)
  //   extends / implements         -> inheritance (hard)
  //   call expressions             -> call (hard), resolved through symbol tables
  //   export { x } from ...        -> re-export, emitted as-is (engine flattens)
  //   import(non-literal)          -> value-import with confidence < 1.0
  // polarity classification:
  //   *.spec.ts*, *.test.ts*, __tests__/   -> TestCase
  //   helpers consumed only by test files  -> TestSupport (computed by reachability)
  //   everything else                      -> Production
  ```
--{ ref: df4d4c5b-e141-4940-907f-797eb39bdd11 }--


  ```rust
  /// discover sources, run adapters, merge fragments, validate, hash
  pub fn snapshot_from_root(root: &Path, cfg: &AnalyzeConfig) -> Result<Snapshot, StrataError>
  // logic:
  //   1. glob source discovery, honoring config include/exclude patterns
  //   2. group files by language; dispatch adapters in parallel (rayon)
  //   3. merge fragments: re-intern ids into one namespace
  //   4. flatten re-export chains to original definitions
  //      (depth guard -> ReExportDepthExceeded on pathological chains)
  //   5. Snapshot::assemble — validate + canonical blake3 hash

  /// pure function of (snapshot, config): condense -> shatter -> layer ->
  /// cluster -> pack -> visibility -> project -> score -> diversify
  pub fn analyze(snapshot: &Snapshot, cfg: &AnalyzeConfig) -> Result<AnalyzeResult, StrataError>

  pub enum StrataError {
      ConfigInvalid, AdapterParseFailure, AdapterBindFailure, SolverTimeout,
      CandidateNotFound, InputUnreadable, SnapshotInvalid, ReExportDepthExceeded,
  }
  ```

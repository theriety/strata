  pub enum SpecConvention { CoLocatedSibling, MirroredFolder }

  /// majority vote over existing spec placements per package; echoed in the report
  pub fn detect_convention(package: &PackageView) -> SpecConvention

  /// place testcase files and validate polarity
  pub fn project(candidate: &mut Candidate, polarity: &[Polarity]) -> Vec<Violation>
  // logic:
  //   for each testcase file: subject = production file receiving the
  //   largest share of the spec's outgoing edge weight; place the spec
  //   beside it (sibling) or at the mirrored path, per the package convention
  //   testsupport was already clustered by the optimizer (standard cap applies)

  /// derived export scope per symbol, plus findings where the declared
  /// visibility is wider than the derived one
  pub fn derive_visibility(tree: &ContainerTree, edges: &[Edge]) -> VisibilityResult
  // logic:
  //   1. build binary-lifting lca tables over the candidate tree
  //      (o(v log v) build, o(log v) per query)
  //   2. scope[s] = lca over { container(c) : c consumes s }
  //      (a symbol nobody consumes stays file-private)
  //   3. transitive type-exposure fixpoint — monotone widening, so it terminates:
  //        repeat until no change:
  //          for every exported f, for every type t in signature(f):
  //            scope[t] = widest(scope[t], scope[f])
  //   4. finding: declared visibility wider than derived -> `visibility` finding
  //      (drives barrel contents: a folder/domain barrel exports exactly the
  //       symbols whose derived scope reaches that level)
  ```
--{ ref: 415a0261-1984-4a96-bd96-f1ca42b93a94 }--


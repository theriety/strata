{{ ref: 61e65211-12c4-4835-9829-e86eb9f6f42c }}
```rust
// cargo add strata-engine
use strata_engine::{analyze, snapshot_from_root, AnalyzeConfig};

let config = AnalyzeConfig::default(); // equals a config-less cli run
let snapshot = snapshot_from_root(".", &config)?;
let result = analyze(&snapshot, &config)?;
println!("{} violations", result.current.violations.len());
```

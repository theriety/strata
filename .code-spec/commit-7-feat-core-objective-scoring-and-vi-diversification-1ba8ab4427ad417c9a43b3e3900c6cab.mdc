  pub struct ModeResult {
      pub candidates: Vec<Candidate>,        // best score first
      pub solution_space_converged: bool,    // true iff fewer than k survived
  }

  pub fn diversify(snapshot: &Snapshot, cfg: &ModeConfig) -> ModeResult
  // logic:
  //   1. pool = rayon-parallel solve(seed = base + i) for i in 0 .. 10 * k
  //      (each run re-executes cluster + pack with its own seed;
  //       results reduced in i-order so thread scheduling cannot leak in)
  //   2. keep candidates with total <= (1 + score_tolerance) * best_total
  //   3. greedy max-min: pick the best; repeatedly pick the candidate
  //      maximizing its minimum vi-distance to those already picked,
  //      requiring pairwise vi >= min_distance
  //   4. fewer than k survivors -> return them all, converged = true

  /// variation of information (meila 2007) over induced symbol partitions —
  /// vi(x, y) = h(x) + h(y) - 2 * i(x, y); a true metric on partitions
  pub fn vi_distance(a: &Partition, b: &Partition) -> f64
  ```

  /// per-candidate score decomposition, reported in the dto
  pub struct ScoreBreakdown {
      pub cut: f64,        // sum over edges of w(e) * c(e) * h(lca_t(e))
      pub imbalance: f64,  // lambda * size-imbalance across sibling containers
      pub naming: f64,     // alpha * shared-token cohesion within containers
      pub path: f64,       // beta * current-path cohesion (anchored mode only)
      pub anchor: f64,     // mu * move distance d(t, t0) from the current tree
      pub total: f64,
  }

  pub fn score(c: &Candidate, k: &Coefficients) -> ScoreBreakdown
  // h(level) is the height penalty: cutting inside a file is cheap,
  // across packages expensive — monotone in lca height
  // hard constraints never appear here: they are vetoes upstream
  ```

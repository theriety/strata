  /// the two-phase contract every language adapter implements (ad-4)
  pub trait Adapter {
      /// parse source files into language-specific syntax trees (rayon-parallel per file)
      fn parse(&self, files: &[SourceFile]) -> Result<Vec<ParseTree>, AdapterError>;
      /// resolve names and emit a language-agnostic ir fragment
      fn bind(&self, trees: Vec<ParseTree>) -> Result<IrFragment, AdapterError>;
  }

  /// partial ir produced by one adapter; the engine merges fragments into one ir
  pub struct IrFragment {
      pub nodes: Vec<Node>,
      pub edges: Vec<Edge>,
      pub containers: Vec<Container>,
  }

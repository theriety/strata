{{ type: toggle, ref: df3621fb-40cc-4b0a-8492-dba4240be2b5 }}
> crates/ir/src/snapshot.rs (new)
  ```rust
  pub struct IntermediateRepresentation {
      /// bumped on any breaking contract change; checked on deserialization
      pub schema_version: u32,
      pub nodes: Vec<Node>,
      pub edges: Vec<Edge>,
      pub containers: ContainerTree,
  }

  /// validated, content-addressed input to the solver — immutable after assembly
  pub struct Snapshot { ir: IntermediateRepresentation, hash: blake3::Hash }

  impl Snapshot {
      /// assembly logic:
      /// 1. every edge endpoint must reference an existing node (else dangling-edge error)
      /// 2. container tree must validate
      /// 3. canonicalize: sort nodes, edges, containers by id
      /// 4. hash = blake3 over the canonical serde serialization
      pub fn assemble(ir: IntermediateRepresentation) -> Result<Snapshot, SnapshotError>

      pub fn hash(&self) -> &blake3::Hash
  }
  ```
